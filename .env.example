# ── US Visa Scheduling credentials ───────────────────────────────────────────
# Your login email and password for usvisascheduling.com
VISA_EMAIL=your@email.com
VISA_PASSWORD=your_password_here

# ── Target appointment window ─────────────────────────────────────────────────
TARGET_YEAR=2026
TARGET_MONTH=6       # 6 = June

# ── Check frequency ───────────────────────────────────────────────────────────
# How often (in seconds) to check for new slots. Default: 120 (2 minutes).
# Don't go lower than 60 to avoid triggering rate-limits / account blocks.
CHECK_INTERVAL_SECONDS=120

# ── Telegram Bot notification ─────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → copy the token below.
# 2. Send any message to your bot, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "id" field from the "chat" object.
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_CHAT_ID=987654321
